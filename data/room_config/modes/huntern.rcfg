htn_mapmask_add "ctf7" 8
htn_mapmask_add "ctf8" 16
htn_mapmask_add "dm1" 1
htn_mapmask_add "dm2" 2
htn_mapmask_add "dm3" 1
htn_mapmask_add "dm6" 1
htn_mapmask_add "dm7" 2
htn_mapmask_add "dm8" 1
htn_mapmask_add "dm9" 1
htn_mapmask_add "lms1" 64
htn_mapmask_add "AliveFNG" 256
htn_mapmask_add "hunter1" 16
htn_mapmask_add "hunter2" 16
htn_mapmask_add "hunter3" 16
htn_mapmask_add "hunter4" 16
htn_mapmask_add "hunter5" 8
htn_mapmask_add "hunter6" 16
htn_mapmask_add "hunter8" 32
htn_mapmask_add "hunter9" 16
htn_mapmask_add "hunter10" 16

htn_maprotations_add hunter1
